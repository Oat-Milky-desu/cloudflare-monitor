{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "server-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "rules": [{ "type": "Text", "globs": ["**/*.py", "**/*.sh", "**/*.service"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "MONITORS", "class_name": "ServerMonitor" },
      { "name": "CONTROL", "class_name": "ControlPlane" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ServerMonitor"] },
    { "tag": "v2", "new_sqlite_classes": ["ControlPlane"] }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "ADMIN_USERNAME": "admin" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
